# Copy to .env to override defaults (read by docker compose and by the app).

# Model tiers (any Ollama model with tool-calling support).
FAST_MODEL=qwen2.5:3b
SMART_MODEL=qwen2.5:7b
# Low-RAM laptop (8 GB): use the same small model for both tiers.
# SMART_MODEL=qwen2.5:3b

# Native Ollama on the host instead of the container (Mac: uses the GPU via Metal, much faster):
# OLLAMA_HOST=http://host.docker.internal:11434

# CPU threads for inference. Leave unset to let Ollama decide; on hybrid Intel CPUs (P+E cores) Ollama may
# pick only the 2 P-cores; setting this to (physical cores - 2) roughly doubles generation speed.
# LLM_NUM_THREAD=8

# Agent tuning
# COMPLEXITY_THRESHOLD=3.0
# ESCALATION_ENABLED=true
# CACHE_ENABLED=true
# CACHE_TTL_S=86400
